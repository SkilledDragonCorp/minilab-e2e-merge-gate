# Required for CI / replay (locator-only) runs: none.
# Always set telemetry opt-out for e2e:
E2E_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# Optional — authoring mode (agent.act) model / provider keys.
# Locators-only checkout.e2e.ts does not need these.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
TYPESAFE_AI_API_KEY=
LLM_API_KEY=

# Optional — hosted browsers / devices (not used by this lab's gate)
KERNEL_API_KEY=
LIMRUN_API_KEY=
LIMRUN_BASE_URL=
EXPO_TOKEN=

# Optional — e2e credentials overrides when authoring with secrets
E2E_USER_SHOPPER_USERNAME=
E2E_USER_SHOPPER_PASSWORD=
E2E_SECRET_CHECKOUT_TOKEN=

# Gate / fixture
E2E_APP_URL=
PLAYWRIGHT_BROWSERS_PATH=
